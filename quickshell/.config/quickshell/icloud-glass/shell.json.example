{
  "schema": 1,
  "theme": "auto",
  "accentFromWallpaper": true,
  "monitor": null,
  "position": "center",
  "hiddenCalendars": [],
  "hiddenLists": [],
  "defaultList": null,
  "syncIntervalMinutes": 15,
  "upcomingCount": 5,
  "reducedMotion": "auto",
  "colors": {
    "dark": {
      "surface": "#0E0E11",
      "surfaceAlpha": 0.38,
      "surfaceRaised": "#22222A",
      "onSurface": "#F5F5F7",
