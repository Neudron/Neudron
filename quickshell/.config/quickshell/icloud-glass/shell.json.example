      "accent": "#0A84FF",
      "stroke": "#FFFFFF",
      "strokeAlpha": 0.14,
      "danger": "#FF453A",
      "success": "#30D158",
      "surfaceRaisedAlpha": 0.92
    },
    "light": {
      "surface": "#FFFFFF",
      "surfaceAlpha": 0.55,
      "surfaceRaised": "#E8E8F0",
      "onSurface": "#1C1C1E",
      "onSurfaceMuted": "#6E6E73",
      "accent": "#0062C4",
      "stroke": "#000000",
      "strokeAlpha": 0.08,
      "danger": "#D70015",
      "success": "#1E7A34",
      "surfaceRaisedAlpha": 0.92
    }
  },
  "calendarColors": {},
  "font": {
    "family": "Inter",
    "scale": 1.0
  }
}
